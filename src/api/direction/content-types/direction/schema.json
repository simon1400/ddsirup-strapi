{
  "kind": "collectionType",
  "collectionName": "directions",
  "info": {
    "singularName": "direction",
    "pluralName": "directions",
    "displayName": "Direction"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "beverageName": {
      "type": "string",
      "required": true
    },
    "amount": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "required": true
    },
    "addIn": {
      "type": "string"
    },
    "boxcolor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "img": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
